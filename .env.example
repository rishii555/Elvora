# ==============================================================================
# Elvora — Multi-Tenant SaaS Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' for local development or '.env.production' for production.
# NEVER commit actual secrets, API keys, or production database passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV="development"

# Fully qualified public application URL (used for redirects, CORS, and email links)
# Local: http://localhost:3000 | Production: https://app.elvora.in
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas or Relational MySQL)
# ------------------------------------------------------------------------------
# Primary (MongoDB Atlas Replica Set):
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/<dbname>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://db_user:YOUR_STRONG_PASSWORD@cluster0.example.mongodb.net/elvora_dev?retryWrites=true&w=majority"

# Optional Alternative (MySQL - if utilizing prisma/schema.mysql.bak):
# DATABASE_URL="mysql://mysql_user:YOUR_STRONG_PASSWORD@localhost:3306/elvora_dev"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Mandatory in production. Generate using: openssl rand -hex 32
SESSION_SECRET="generate_a_minimum_64_hex_character_random_secret_for_user_sessions"
ADMIN_SESSION_SECRET="generate_a_minimum_64_hex_character_random_secret_for_admin_portal"

# ------------------------------------------------------------------------------
# 4. COMMERCIAL BILLING & SUBSCRIPTIONS
# ------------------------------------------------------------------------------
# Billing Provider Mode: 'mock' (default, 100% free local dev) | 'razorpay' | 'stripe'
BILLING_PROVIDER="mock"

# Production Razorpay Configuration (Used when BILLING_PROVIDER=razorpay):
RAZORPAY_KEY_ID="rzp_test_or_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_signing_secret"

# Production Stripe Configuration (Used when BILLING_PROVIDER=stripe):
STRIPE_SECRET_KEY="sk_test_or_live_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL DISPATCHER (Optional in Development)
# ------------------------------------------------------------------------------
# When unset in development, emails (reset passwords, invites) log to server console.
# Resend Provider (Free 3,000 emails/month):
RESEND_API_KEY=""
EMAIL_FROM="Elvora Invoicing <billing@elvora.in>"

# Alternative SMTP Provider (e.g. Mailtrap / Amazon SES / Brevo):
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED CACHE & RATE LIMITING (Optional in Single-Instance Dev)
# ------------------------------------------------------------------------------
# For multi-replica autoscaling clusters, set an encrypted Redis connection.
# Free Tier: Upstash Redis (10,000 commands/day free)
# REDIS_URL="rediss://default:token@cluster.upstash.io:6379"
