generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. Core Tenant, User & Role-Based Access Control (RBAC)
// -------------------------------------------------------------

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Tenant {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  legalName         String              @map("legal_name")
  tradeName         String              @map("trade_name")
  gstin             String?             @map("gstin")
  stateCode         String              @default("09") @map("state_code")
  phone             String
  email             String?
  address           String?
  allowNegativeStock Boolean            @default(false) @map("allow_negative_stock")
  invoicePrefix     String              @default("INV-") @map("invoice_prefix")
  nextInvoiceNumber Int                 @default(1) @map("next_invoice_number")
  currency          String              @default("INR")
  isActive          Boolean             @default(true) @map("is_active")
  approvalStatus    AccountStatus       @default(PENDING) @map("approval_status")
  rejectionReason   String?             @map("rejection_reason")
  reviewedBy        String?             @map("reviewed_by")
  reviewedAt        DateTime?           @map("reviewed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  members           TenantMember[]
  locations         InventoryLocation[]
  brands            Brand[]
  categories        Category[]
  products          Product[]
  variants          ProductVariant[]
  supplierPrices    SupplierProductPrice[]
  stockMovements    StockMovement[]
  suppliers         Supplier[]
  customers         Customer[]
  purchaseInvoices  PurchaseInvoice[]
  purchaseReturns   PurchaseReturn[]
  salesInvoices     SalesInvoice[]
  salesReturns      SalesReturn[]
  creditDebitNotes  CreditDebitNote[]
  payments          Payment[]
  expenses          Expense[]
  ledgerAccounts    LedgerAccount[]
  ledgerEntries     LedgerEntry[]
  journalEntries    JournalEntry[]
  taxClassifications TaxClassification[]
  invoiceSequences  InvoiceSequence[]
  auditLogs         AuditLog[]
  subscription      Subscription?
  usage             TenantUsage?
  config            TenantConfig?
  locationStocks    LocationStock[]
  reservations      StockReservation[]
  automationRules   AutomationRule[]
  automationExecutions AutomationExecution[]
  automationEvents  AutomationEvent[]
  scheduledTasks    ScheduledTask[]
  notifications     Notification[]
  notificationPreferences NotificationPreference[]
  workflowApprovals WorkflowApproval[]
  followUpTasks     FollowUpTask[]
  recurringTransactions RecurringTransaction[]
  scheduledReportSchedules ScheduledReportSchedule[]
  invoiceReminderLogs InvoiceReminderLog[]
  assistantConversations AssistantConversation[]
  assistantMessages     AssistantMessage[]

  @@map("tenants")
}

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  email           String         @unique
  passwordHash    String         @map("password_hash")
  name            String
  phone           String?
  isActive        Boolean        @default(true) @map("is_active")
  approvalStatus  AccountStatus  @default(PENDING) @map("approval_status")
  rejectionReason String?        @map("rejection_reason")
  reviewedBy      String?        @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  memberships  TenantMember[]
  auditLogs    AuditLog[]
  assistantConversations AssistantConversation[]

  @@map("users")
}

enum TenantRole {
  OWNER
  MANAGER
  BILLER
  ACCOUNTANT
}

model TenantMember {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String     @map("tenant_id") @db.ObjectId
  userId    String     @map("user_id") @db.ObjectId
  role      TenantRole @default(BILLER)
  isDefault Boolean    @default(false) @map("is_default")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

// -------------------------------------------------------------
// 2. Business Settings, Tax Configuration & Numbering Sequences
// -------------------------------------------------------------

model TaxClassification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @map("tenant_id") @db.ObjectId
  name      String   // e.g. "GST 18%", "GST 12%", "GST 5%", "GST 0% / Nil", "Exempt"
  code      String   // e.g. "GST_18", "GST_12", "GST_5", "GST_0", "EXEMPT"
  rate      Float    // e.g. 18.0
  cgstRate  Float    @map("cgst_rate") // e.g. 9.0
  sgstRate  Float    @map("sgst_rate") // e.g. 9.0
  igstRate  Float    @map("igst_rate") // e.g. 18.0
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tax_classifications")
}

model InvoiceSequence {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String   @map("tenant_id") @db.ObjectId
  fiscalYear String   @map("fiscal_year") // e.g. "2026-27"
  seriesType String   @map("series_type") // "TAX_INVOICE", "RETAIL_BILL", "CREDIT_NOTE", "PURCHASE_BILL"
  prefix     String   @default("INV-")
  nextNumber Int      @default(1) @map("next_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fiscalYear, seriesType])
  @@map("invoice_sequences")
}

// -------------------------------------------------------------
// 3. Inventory Locations, Catalog & Multi-Location Stock
// -------------------------------------------------------------

model InventoryLocation {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String          @map("tenant_id") @db.ObjectId
  name      String          // e.g. "Main Store Counter", "Warehouse A", "Godown Central"
  code      String?
  address   String?
  isDefault Boolean         @default(false) @map("is_default")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  stocks    LocationStock[]
  reservations StockReservation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("inventory_locations")
}

model LocationStock {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String            @map("tenant_id") @db.ObjectId
  locationId String            @map("location_id") @db.ObjectId
  variantId  String            @map("variant_id") @db.ObjectId
  stock      Float             @default(0.0) @db.Double
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([locationId, variantId])
  @@index([tenantId, locationId])
  @@index([tenantId, variantId])
  @@map("location_stocks")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  CONSUMED
}

model StockReservation {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String             @map("tenant_id") @db.ObjectId
  locationId    String?            @map("location_id") @db.ObjectId
  variantId     String             @map("variant_id") @db.ObjectId
  quantity      Float              @db.Double
  status        ReservationStatus  @default(PENDING)
  referenceType String             @map("reference_type")
  referenceId   String             @map("reference_id")
  notes         String?
  expiresAt     DateTime?          @map("expires_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: NoAction)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, variantId, status])
  @@index([tenantId, locationId, status])
  @@index([tenantId, referenceType, referenceId])
  @@map("stock_reservations")
}

model Brand {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String    @map("tenant_id") @db.ObjectId
  name      String
  code      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

model Category {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String     @map("tenant_id") @db.ObjectId
  name      String
  code      String?
  parentId  String?    @map("parent_id") @db.ObjectId
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

enum UnitOfMeasure {
  PCS
  SET
  BOX
  MTR
  PAIR
  KG
}

model Product {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String          @map("tenant_id") @db.ObjectId
  name          String
  code          String          @map("code") // SKU / Item Code
  barcode       String?
  brandId       String?         @map("brand_id") @db.ObjectId
  categoryId    String?         @map("category_id") @db.ObjectId
  hsnCode       String?         @map("hsn_code")
  uom           UnitOfMeasure   @default(PCS)
  description   String?
  minStockAlert Float           @default(5.0) @map("min_stock_alert") @db.Double
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand         Brand?          @relation(fields: [brandId], references: [id], onDelete: NoAction)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  variants      ProductVariant[]

  @@unique([tenantId, code])
  @@index([tenantId, barcode])
  @@index([tenantId, name])
  @@map("products")
}

model ProductVariant {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String                @map("tenant_id") @db.ObjectId
  productId        String                @map("product_id") @db.ObjectId
  name             String                @default("Standard")
  sku              String
  barcode          String?
  model            String?               // e.g. "Wall Hung Rimless", "Single Lever Diverter"
  size             String?               // e.g. "18x12 inch", "550x400 mm"
  colorFinish      String?               @map("color_finish") // e.g. "Chrome Plated", "Matte Black", "Rose Gold"
  customAttributes Json?                 @map("custom_attributes")
  purchasePrice    Float                 @default(0.00) @map("purchase_price")
  sellingPrice     Float                 @default(0.00) @map("selling_price")
  mrp              Float                 @default(0.00) @map("mrp")
  gstRate          Float                 @default(18.00) @map("gst_rate")
  currentStock     Float                 @default(0.0) @map("current_stock") @db.Double
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements        StockMovement[]
  supplierPrices   SupplierProductPrice[]
  purchaseItems       PurchaseInvoiceItem[]
  purchaseReturnItems PurchaseReturnItem[]
  salesItems          SalesInvoiceItem[]
  salesReturnItems SalesReturnItem[]
  locationStocks   LocationStock[]
  reservations     StockReservation[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER
}

model StockMovement {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String             @map("tenant_id") @db.ObjectId
  locationId    String?            @map("location_id") @db.ObjectId
  variantId     String             @map("variant_id") @db.ObjectId
  type          StockMovementType
  quantity      Float              @db.Double
  unitCost      Float              @map("unit_cost")
  balanceAfter  Float              @map("balance_after") @db.Double
  referenceType String?            @map("reference_type")
  referenceId   String?            @map("reference_id")
  reason        String?            // "OPENING_STOCK", "DAMAGED", "SCRAPPED", "AUDIT_CORRECTION", "INTERNAL_USE", "THEFT_OR_LOSS"
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: NoAction)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, variantId])
  @@index([tenantId, locationId])
  @@index([tenantId, referenceId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

// -------------------------------------------------------------
// 4. Suppliers & Purchase Orders
// -------------------------------------------------------------

model Supplier {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String                 @map("tenant_id") @db.ObjectId
  name           String
  companyName    String?                @map("company_name")
  gstin          String?
  phone          String
  email          String?
  address        String?
  stateCode      String                 @default("09") @map("state_code")
  balance        Float                  @default(0.00)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases      PurchaseInvoice[]
  purchaseReturns PurchaseReturn[]
  payments       Payment[]
  supplierPrices SupplierProductPrice[]

  @@index([tenantId, name])
  @@map("suppliers")
}

model SupplierProductPrice {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String          @map("tenant_id") @db.ObjectId
  supplierId       String          @map("supplier_id") @db.ObjectId
  variantId        String          @map("variant_id") @db.ObjectId
  supplierItemCode String?         @map("supplier_item_code")
  purchasePrice    Float           @map("purchase_price")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, variantId])
  @@index([tenantId, variantId])
  @@map("supplier_product_prices")
}

model PurchaseInvoice {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String                @map("tenant_id") @db.ObjectId
  supplierId      String                @map("supplier_id") @db.ObjectId
  invoiceNumber   String                @map("invoice_number") // Vendor bill #
  invoiceDate     DateTime              @map("invoice_date")
  dueDate         DateTime?             @map("due_date")
  isInterState    Boolean               @default(false) @map("is_inter_state")
  subtotal        Float
  discountAmount  Float                 @default(0.00) @map("discount_amount")
  taxableAmount   Float                 @default(0.00) @map("taxable_amount")
  cgstAmount      Float                 @default(0.00) @map("cgst_amount")
  sgstAmount      Float                 @default(0.00) @map("sgst_amount")
  igstAmount      Float                 @default(0.00) @map("igst_amount")
  taxTotal        Float                 @map("tax_total")
  freightAmount   Float                 @default(0.00) @map("freight_amount")
  roundOff        Float                 @default(0.00) @map("round_off")
  grandTotal      Float                 @map("grand_total")
  paidAmount      Float                 @default(0.00) @map("paid_amount")
  balanceAmount   Float                 @default(0.00) @map("balance_amount")
  paymentStatus   String                @default("UNPAID") @map("payment_status")
  status          String                @default("RECEIVED")
  cancelReason    String?               @map("cancel_reason")
  cancelledAt     DateTime?             @map("cancelled_at")
  notes           String?
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier              @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  items           PurchaseInvoiceItem[]
  allocations     PaymentAllocation[]
  creditDebitNotes CreditDebitNote[]
  purchaseReturns PurchaseReturn[]

  @@unique([tenantId, supplierId, invoiceNumber])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String          @map("tenant_id") @db.ObjectId
  purchaseInvoiceId String          @map("purchase_invoice_id") @db.ObjectId
  variantId         String          @map("variant_id") @db.ObjectId
  sku               String?
  productName       String?         @map("product_name")
  variantName       String?         @map("variant_name")
  quantity          Float           @db.Double
  unitCost          Float           @map("unit_cost")
  discountPercent   Float           @default(0.00) @map("discount_percent")
  discountAmount    Float           @default(0.00) @map("discount_amount")
  taxableAmount     Float           @default(0.00) @map("taxable_amount")
  gstRate           Float           @map("gst_rate")
  cgstAmount        Float           @default(0.00) @map("cgst_amount")
  sgstAmount        Float           @default(0.00) @map("sgst_amount")
  igstAmount        Float           @default(0.00) @map("igst_amount")
  taxAmount         Float           @map("tax_amount")
  totalAmount       Float           @map("total_amount")

  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: NoAction)

  @@index([tenantId, purchaseInvoiceId])
  @@map("purchase_invoice_items")
}

// -------------------------------------------------------------
// 5. Customers & Sales Invoices
// -------------------------------------------------------------

model Customer {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String         @map("tenant_id") @db.ObjectId
  name               String
  phone              String
  email              String?
  gstin              String?
  stateCode          String         @default("09") @map("state_code")
  address            String?
  creditLimit        Float          @default(0.00) @map("credit_limit")
  outstandingBalance Float          @default(0.00) @map("outstanding_balance")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoices      SalesInvoice[]
  salesReturns       SalesReturn[]
  payments           Payment[]

  @@index([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

enum InvoiceType {
  B2B_TAX_INVOICE
  B2C_RETAIL_BILL
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CREDIT
  SPLIT
}

model SalesInvoice {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String              @map("tenant_id") @db.ObjectId
  customerId       String?             @map("customer_id") @db.ObjectId
  customerName     String              @map("customer_name")
  customerPhone    String?             @map("customer_phone")
  customerGstin    String?             @map("customer_gstin")
  customerState    String              @default("09") @map("customer_state")
  billingAddress   String?             @map("billing_address")
  shippingAddress  String?             @map("shipping_address")
  placeOfSupply    String?             @map("place_of_supply")
  invoiceNumber    String              @map("invoice_number")
  invoiceDate      DateTime            @default(now()) @map("invoice_date")
  dueDate          DateTime?           @map("due_date")
  invoiceType      InvoiceType         @default(B2C_RETAIL_BILL) @map("invoice_type")
  isInterState     Boolean             @default(false) @map("is_inter_state")
  isTaxInclusive   Boolean             @default(false) @map("is_tax_inclusive")
  subtotal         Float
  discountAmount   Float               @default(0.00) @map("discount_amount")
  taxableAmount    Float               @map("taxable_amount")
  cgstAmount       Float               @default(0.00) @map("cgst_amount")
  sgstAmount       Float               @default(0.00) @map("sgst_amount")
  igstAmount       Float               @default(0.00) @map("igst_amount")
  roundOff         Float               @default(0.00) @map("round_off")
  grandTotal       Float               @map("grand_total")
  paidAmount       Float               @default(0.00) @map("paid_amount")
  balanceAmount    Float               @default(0.00) @map("balance_amount")
  paymentMode      PaymentMode         @default(CASH) @map("payment_mode")
  status           InvoiceStatus       @default(FINALIZED)
  idempotencyKey   String?             @map("idempotency_key")
  cancelReason     String?             @map("cancel_reason")
  cancelledAt      DateTime?           @map("cancelled_at")
  printCount       Int                 @default(0) @map("print_count")
  notes            String?
  createdByUserId  String              @map("created_by_user_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: NoAction)
  items            SalesInvoiceItem[]
  creditDebitNotes CreditDebitNote[]
  salesReturns     SalesReturn[]
  allocations      PaymentAllocation[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, status])
  @@index([tenantId, status, invoiceDate])
  @@index([tenantId, status, balanceAmount])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, customerId])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String         @map("tenant_id") @db.ObjectId
  salesInvoiceId  String         @map("sales_invoice_id") @db.ObjectId
  variantId       String         @map("variant_id") @db.ObjectId
  sku             String?
  productName     String         @map("product_name")
  variantName     String         @map("variant_name")
  hsnCode         String?        @map("hsn_code")
  uom             UnitOfMeasure  @default(PCS)
  quantity        Float          @db.Double
  unitPrice       Float          @map("unit_price")
  isTaxInclusive  Boolean        @default(false) @map("is_tax_inclusive")
  discountPercent Float          @default(0.00) @map("discount_percent")
  discountAmount  Float          @default(0.00) @map("discount_amount")
  taxableAmount   Float          @map("taxable_amount")
  gstRate         Float          @map("gst_rate")
  cgstAmount      Float          @default(0.00) @map("cgst_amount")
  sgstAmount      Float          @default(0.00) @map("sgst_amount")
  igstAmount      Float          @default(0.00) @map("igst_amount")
  totalAmount     Float          @map("total_amount")

  invoice         SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction)

  @@index([tenantId, salesInvoiceId])
  @@map("sales_invoice_items")
}

// -------------------------------------------------------------
// 6. Payments, Receipts & Invoice Allocations
// -------------------------------------------------------------

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
}

model Payment {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String              @map("tenant_id") @db.ObjectId
  paymentNumber   String              @map("payment_number") // e.g. "RCT-2026-0001"
  paymentType     PaymentType         @map("payment_type")
  paymentDate     DateTime            @default(now()) @map("payment_date")
  customerId      String?             @map("customer_id") @db.ObjectId
  supplierId      String?             @map("supplier_id") @db.ObjectId
  amount          Float
  paymentMode     PaymentMode         @default(CASH) @map("payment_mode")
  referenceNumber String?             @map("reference_number") // UTR, UPI ref, Cheque #
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: NoAction)
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  allocations     PaymentAllocation[]

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, paymentDate])
  @@map("payments")
}

model PaymentAllocation {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String           @map("tenant_id") @db.ObjectId
  paymentId         String           @map("payment_id") @db.ObjectId
  salesInvoiceId    String?          @map("sales_invoice_id") @db.ObjectId
  purchaseInvoiceId String?          @map("purchase_invoice_id") @db.ObjectId
  amount            Float            // Amount knocked off from invoice balance
  createdAt         DateTime         @default(now()) @map("created_at")

  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  salesInvoice      SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id], onDelete: NoAction)
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: NoAction)

  @@index([tenantId, paymentId])
  @@index([tenantId, salesInvoiceId])
  @@index([tenantId, purchaseInvoiceId])
  @@map("payment_allocations")
}

// -------------------------------------------------------------
// 7. Returns, Credit / Debit Notes & Corrections
// -------------------------------------------------------------

model SalesReturn {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String            @map("tenant_id") @db.ObjectId
  returnNumber      String            @map("return_number")
  originalInvoiceId String            @map("original_invoice_id") @db.ObjectId
  customerId        String?           @map("customer_id") @db.ObjectId
  returnDate        DateTime          @default(now()) @map("return_date")
  reason            String
  subtotal          Float
  taxTotal          Float             @map("tax_total")
  grandTotal        Float             @map("grand_total")
  createdAt         DateTime          @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           SalesInvoice      @relation(fields: [originalInvoiceId], references: [id], onDelete: NoAction)
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: NoAction)
  items             SalesReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, originalInvoiceId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String         @map("tenant_id") @db.ObjectId
  salesReturnId String         @map("sales_return_id") @db.ObjectId
  variantId     String         @map("variant_id") @db.ObjectId
  quantity      Float          @db.Double
  unitPrice     Float          @map("unit_price")
  taxAmount     Float          @map("tax_amount")
  totalAmount   Float          @map("total_amount")

  salesReturn   SalesReturn    @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction)

  @@index([tenantId, salesReturnId])
  @@map("sales_return_items")
}

enum NoteType {
  CREDIT_NOTE
  DEBIT_NOTE
}

model CreditDebitNote {
  id                        String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                  String           @map("tenant_id") @db.ObjectId
  originalInvoiceId         String?          @map("original_invoice_id") @db.ObjectId
  originalPurchaseInvoiceId String?          @map("original_purchase_invoice_id") @db.ObjectId
  noteType                  NoteType         @map("note_type")
  noteNumber                String           @map("note_number")
  noteDate                  DateTime         @default(now()) @map("note_date")
  reason                    String
  subtotal                  Float
  taxAmount                 Float            @map("tax_amount")
  grandTotal                Float            @map("grand_total")
  createdByUserId           String?          @map("created_by_user_id")
  createdAt                 DateTime         @default(now()) @map("created_at")

  tenant                    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice                   SalesInvoice?    @relation(fields: [originalInvoiceId], references: [id], onDelete: NoAction)
  purchaseInvoice           PurchaseInvoice? @relation(fields: [originalPurchaseInvoiceId], references: [id], onDelete: NoAction)

  @@unique([tenantId, noteNumber])
  @@index([tenantId, originalInvoiceId])
  @@index([tenantId, originalPurchaseInvoiceId])
  @@map("credit_debit_notes")
}

model PurchaseReturn {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String               @map("tenant_id") @db.ObjectId
  returnNumber      String               @map("return_number")
  purchaseInvoiceId String               @map("purchase_invoice_id") @db.ObjectId
  supplierId        String               @map("supplier_id") @db.ObjectId
  returnDate        DateTime             @default(now()) @map("return_date")
  reason            String
  subtotal          Float
  taxTotal          Float                @map("tax_total")
  grandTotal        Float                @map("grand_total")
  createdAt         DateTime             @default(now()) @map("created_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  supplier          Supplier             @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  items             PurchaseReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, purchaseInvoiceId])
  @@index([tenantId, supplierId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String          @map("tenant_id") @db.ObjectId
  purchaseReturnId String          @map("purchase_return_id") @db.ObjectId
  variantId        String          @map("variant_id") @db.ObjectId
  quantity         Float           @db.Double
  unitCost         Float           @map("unit_cost")
  taxAmount        Float           @map("tax_amount")
  totalAmount      Float           @map("total_amount")

  purchaseReturn   PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: NoAction)

  @@index([tenantId, purchaseReturnId])
  @@map("purchase_return_items")
}

// -------------------------------------------------------------
// 8. Double-Entry Accounting, General Ledger & Journal Entries
// -------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model LedgerAccount {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String        @map("tenant_id") @db.ObjectId
  code         String        // e.g. "1010_CASH", "1020_BANK", "1030_ACCOUNTS_RECEIVABLE", "4010_SALES"
  name         String
  type         AccountType
  category     String?       // "Current Assets", "Operating Revenue", "Direct Expenses", etc.
  isSystem     Boolean       @default(true) @map("is_system")
  balance      Float         @default(0.00)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries      LedgerEntry[]
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String        @map("tenant_id") @db.ObjectId
  accountId     String        @map("account_id") @db.ObjectId
  entryDate     DateTime      @default(now()) @map("entry_date")
  description   String
  debit         Float         @default(0.00)
  credit        Float         @default(0.00)
  referenceType String?       @map("reference_type")
  referenceId   String?       @map("reference_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account       LedgerAccount @relation(fields: [accountId], references: [id], onDelete: NoAction)

  @@index([tenantId, accountId])
  @@index([tenantId, entryDate])
  @@index([tenantId, accountId, entryDate])
  @@map("ledger_entries")
}

model JournalEntry {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String        @map("tenant_id") @db.ObjectId
  entryNumber   String        @map("entry_number") // e.g. "JRN-2026-0001"
  entryDate     DateTime      @default(now()) @map("entry_date")
  narration     String
  referenceType String?       @map("reference_type")
  referenceId   String?       @map("reference_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines         JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, entryDate])
  @@index([tenantId, referenceType, referenceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String        @map("tenant_id") @db.ObjectId
  journalId   String        @map("journal_id") @db.ObjectId
  accountId   String        @map("account_id") @db.ObjectId
  debit       Float         @default(0.00)
  credit      Float         @default(0.00)
  description String?

  journal     JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: NoAction)

  @@index([tenantId, journalId])
  @@index([tenantId, accountId])
  @@map("journal_lines")
}

model Expense {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String      @map("tenant_id") @db.ObjectId
  expenseNumber String      @map("expense_number") // e.g. "EXP-2627-0001"
  expenseDate   DateTime    @default(now()) @map("expense_date")
  category      String      // "RENT", "SALARIES", "ELECTRICITY", "OFFICE_SUPPLIES", "MARKETING", "MAINTENANCE"
  payee         String
  amount        Float
  taxAmount     Float       @default(0.00) @map("tax_amount")
  paymentMode   PaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  paymentRef    String?     @map("payment_ref")
  description   String?
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, expenseNumber])
  @@index([tenantId, expenseDate])
  @@index([tenantId, category])
  @@map("expenses")
}

// -------------------------------------------------------------
// 9. Auditing, Security & Event Logs
// -------------------------------------------------------------

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @map("tenant_id") @db.ObjectId
  userId      String?  @map("user_id") @db.ObjectId
  action      String   // e.g. "INVOICE_CREATED", "STOCK_ADJUSTED", "PAYMENT_RECORDED"
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  changesJson String?  @map("changes_json")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 10. Commercial SaaS Subscriptions, Plans & Platform Admin
// -------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  GRACE_PERIOD
}

model SubscriptionPlan {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  code                String         @unique // "FREE_TRIAL", "STARTER", "GROWTH", "ENTERPRISE"
  name                String
  description         String?
  priceMonthly        Float          @default(0.00) @map("price_monthly")
  priceYearly         Float          @default(0.00) @map("price_yearly")
  maxProducts         Int            @default(100) @map("max_products") // -1 for unlimited
  maxInvoicesPerMonth Int            @default(50) @map("max_invoices_per_month") // -1 for unlimited
  maxStaffMembers     Int            @default(2) @map("max_staff_members")
  hasAdvancedReports  Boolean        @default(false) @map("has_advanced_reports")
  hasAuditLogs        Boolean        @default(false) @map("has_audit_logs")
  hasMultiLocation    Boolean        @default(false) @map("has_multi_location")
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  subscriptions       Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId               String             @unique @map("tenant_id") @db.ObjectId
  planId                 String             @map("plan_id") @db.ObjectId
  status                 SubscriptionStatus @default(TRIALING)
  billingProvider        String             @default("MOCK") @map("billing_provider") // "MOCK", "STRIPE", "RAZORPAY"
  providerSubscriptionId String?            @map("provider_subscription_id")
  providerCustomerId     String?            @map("provider_customer_id")
  currentPeriodStart     DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: NoAction)

  @@index([status])
  @@map("subscriptions")
}

model TenantUsage {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String   @unique @map("tenant_id") @db.ObjectId
  monthlyInvoiceCount Int      @default(0) @map("monthly_invoice_count")
  lastResetDate       DateTime @default(now()) @map("last_reset_date")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_usages")
}

model TenantConfig {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String   @unique @map("tenant_id") @db.ObjectId
  businessType        String   @default("general") @map("business_type")
  version             Int      @default(1)
  enablePos           Boolean  @default(true) @map("enable_pos")
  enableWarehouses    Boolean  @default(false) @map("enable_warehouses")
  enableSerialImei    Boolean  @default(false) @map("enable_serial_imei")
  enableMatrixVariant Boolean  @default(false) @map("enable_matrix_variant")
  enableCreditLimit   Boolean  @default(false) @map("enable_credit_limit")
  activeAttributes    String[] @default([]) @map("active_attributes")
  invoiceSettingsJson String?  @map("invoice_settings_json")
  dashboardCardsJson  String?  @map("dashboard_cards_json")
  onboardingStep      Int      @default(1) @map("onboarding_step")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  onboardingDraftJson String?  @map("onboarding_draft_json")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([businessType])
  @@map("tenant_configs")
}

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT_AGENT
}

model PlatformAdminUser {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  email        String            @unique
  passwordHash String            @map("password_hash")
  name         String
  role         PlatformAdminRole @default(SUPPORT_AGENT)
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("platform_admin_users")
}

// -------------------------------------------------------------
// 12. Business Automation, Workflows & Scheduled Tasks
// -------------------------------------------------------------

enum AutomationTriggerType {
  EVENT
  SCHEDULE
}

enum AutomationActionType {
  SEND_NOTIFICATION
  CREATE_REMINDER
  REQUEST_APPROVAL
  EXECUTE_RECURRING
  CREATE_PURCHASE_DRAFT
  GENERATE_REPORT
}

model AutomationRule {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String                @map("tenant_id") @db.ObjectId
  name             String
  description      String?
  triggerType      AutomationTriggerType @default(EVENT) @map("trigger_type")
  eventType        String?               @map("event_type")
  conditionsJson   String?               @map("conditions_json")
  actionType       AutomationActionType  @default(SEND_NOTIFICATION) @map("action_type")
  actionConfigJson String?               @map("action_config_json")
  isEnabled        Boolean               @default(true) @map("is_enabled")
  createdById      String?               @map("created_by_id") @db.ObjectId
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions       AutomationExecution[]

  @@index([tenantId, isEnabled])
  @@index([tenantId, triggerType])
  @@index([tenantId, eventType])
  @@map("automation_rules")
}

model AutomationExecution {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String          @map("tenant_id") @db.ObjectId
  ruleId       String?         @map("rule_id") @db.ObjectId
  triggerType  String          @map("trigger_type")
  eventType    String?         @map("event_type")
  entityType   String?         @map("entity_type")
  entityId     String?         @map("entity_id")
  status       String          @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED, SKIPPED
  errorMessage String?         @map("error_message")
  executionLog String?         @map("execution_log")
  retriesCount Int             @default(0) @map("retries_count")
  executedAt   DateTime        @default(now()) @map("executed_at")
  durationMs   Int?            @map("duration_ms")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule         AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, executedAt])
  @@index([tenantId, ruleId])
  @@map("automation_executions")
}

model AutomationEvent {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String    @map("tenant_id") @db.ObjectId
  eventType      String    @map("event_type")
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  payloadJson    String    @map("payload_json")
  idempotencyKey String    @unique @map("idempotency_key")
  status         String    @default("PENDING") // PENDING, PROCESSED, FAILED, IGNORED
  error          String?
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, eventType])
  @@map("automation_events")
}

model ScheduledTask {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String    @map("tenant_id") @db.ObjectId
  taskType       String    @map("task_type") // INVOICE_REMINDERS, STOCK_ALERTS, RECURRING_INVOICES, RECURRING_EXPENSES, SCHEDULED_REPORTS
  name           String
  frequency      String    @default("DAILY") // HOURLY, DAILY, WEEKLY, MONTHLY
  cronExpression String?   @map("cron_expression")
  nextRunAt      DateTime  @map("next_run_at")
  lastRunAt      DateTime? @map("last_run_at")
  status         String    @default("IDLE") // IDLE, RUNNING, COMPLETED, FAILED
  lockedUntil    DateTime? @map("locked_until")
  configJson     String?   @map("config_json")
  isEnabled      Boolean   @default(true) @map("is_enabled")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isEnabled, nextRunAt])
  @@index([status, lockedUntil])
  @@map("scheduled_tasks")
}

model Notification {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String    @map("tenant_id") @db.ObjectId
  userId       String?   @map("user_id") @db.ObjectId
  title        String
  message      String
  category     String    @default("AUTOMATION") // PAYMENTS, INVOICES, INVENTORY, APPROVALS, EXPENSES, PURCHASES, REPORTS, AUTOMATION
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  linkUrl      String?   @map("link_url")
  isRead       Boolean   @default(false) @map("is_read")
  readAt       DateTime? @map("read_at")
  metadataJson String?   @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([tenantId, category])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String   @map("tenant_id") @db.ObjectId
  userId           String   @map("user_id") @db.ObjectId
  category         String   // PAYMENTS, INVOICES, INVENTORY, APPROVALS, EXPENSES, PURCHASES, REPORTS, AUTOMATION
  inAppEnabled     Boolean  @default(true) @map("in_app_enabled")
  emailMockEnabled Boolean  @default(true) @map("email_mock_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category])
  @@map("notification_preferences")
}

model WorkflowApproval {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String    @map("tenant_id") @db.ObjectId
  workflowType    String    @map("workflow_type") // PURCHASE_ORDER, EXPENSE, PAYMENT, STOCK_ADJUSTMENT, JOURNAL_ENTRY
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id")
  entityNumber    String?   @map("entity_number")
  amount          Float?    @db.Double
  requesterId     String    @map("requester_id") @db.ObjectId
  requesterName   String?   @map("requester_name")
  approverId      String?   @map("approver_id") @db.ObjectId
  approverName    String?   @map("approver_name")
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  rejectionReason String?   @map("rejection_reason")
  approvalNotes   String?   @map("approval_notes")
  metadataJson    String?   @map("metadata_json")
  approvedAt      DateTime? @map("approved_at")
  rejectedAt      DateTime? @map("rejected_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, workflowType])
  @@index([tenantId, requesterId])
  @@map("workflow_approvals")
}

model FollowUpTask {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String    @map("tenant_id") @db.ObjectId
  targetType   String    @default("CUSTOMER") @map("target_type") // CUSTOMER, SUPPLIER, INVOICE, PURCHASE
  customerId   String?   @map("customer_id") @db.ObjectId
  supplierId   String?   @map("supplier_id") @db.ObjectId
  invoiceId    String?   @map("invoice_id") @db.ObjectId
  title        String
  notes        String?
  dueDate      DateTime  @map("due_date")
  assignedToId String?   @map("assigned_to_id") @db.ObjectId
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, supplierId])
  @@map("follow_up_tasks")
}

model RecurringTransaction {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String    @map("tenant_id") @db.ObjectId
  transactionType String    @map("transaction_type") // INVOICE, EXPENSE
  title           String
  frequency       String    @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  customerId      String?   @map("customer_id") @db.ObjectId
  supplierId      String?   @map("supplier_id") @db.ObjectId
  templateData    String    @map("template_data") // JSON
  nextRunDate     DateTime  @map("next_run_date")
  lastRunDate     DateTime? @map("last_run_date")
  endDate         DateTime? @map("end_date")
  isActive        Boolean   @default(true) @map("is_active")
  totalGenerated  Int       @default(0) @map("total_generated")
  lastGeneratedId String?   @map("last_generated_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, nextRunDate])
  @@index([tenantId, transactionType])
  @@map("recurring_transactions")
}

model ScheduledReportSchedule {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId             String    @map("tenant_id") @db.ObjectId
  reportType           String    @map("report_type") // SALES_SUMMARY, PURCHASE_SUMMARY, PROFIT_LOSS, etc.
  frequency            String    @default("DAILY") // DAILY, WEEKLY, MONTHLY
  recipientsJson       String?   @map("recipients_json")
  format               String    @default("CSV")
  nextRunDate          DateTime  @map("next_run_date")
  lastRunDate          DateTime? @map("last_run_date")
  isEnabled            Boolean   @default(true) @map("is_enabled")
  lastGeneratedSummary String?   @map("last_generated_summary")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isEnabled, nextRunDate])
  @@map("scheduled_report_schedules")
}

model InvoiceReminderLog {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String   @map("tenant_id") @db.ObjectId
  invoiceId         String   @map("invoice_id") @db.ObjectId
  customerId        String   @map("customer_id") @db.ObjectId
  reminderType      String   @map("reminder_type") // BEFORE_DUE, ON_DUE, OVERDUE_PERIODIC, MANUAL
  channel           String   @default("IN_APP") // IN_APP, EMAIL_MOCK, SMS_MOCK
  sentAt            DateTime @default(now()) @map("sent_at")
  recipientName     String?  @map("recipient_name")
  outstandingAmount Float    @db.Double @map("outstanding_amount")
  daysOverdue       Int      @default(0) @map("days_overdue")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, customerId])
  @@index([sentAt])
  @@map("invoice_reminder_logs")
}

// -------------------------------------------------------------
// 12. Session Invalidation & Distributed Idempotency Guards
// -------------------------------------------------------------

model RevokedToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model IdempotencyRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @map("tenant_id") @db.ObjectId
  key          String   @map("key")
  action       String   @map("action")
  status       String   @default("PENDING") // PENDING, COMPLETED, FAILED
  responseJson String?  @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([tenantId, key])
  @@index([tenantId, action])
  @@index([expiresAt])
  @@map("idempotency_records")
}


// -------------------------------------------------------------
// 13. Elvora Unified Assistant & Chatbot Conversation Models
// -------------------------------------------------------------

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model AssistantConversation {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String             @map("tenant_id") @db.ObjectId
  userId    String             @map("user_id") @db.ObjectId
  title     String             @default("New Conversation")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]

  @@index([tenantId, userId, updatedAt(sort: Desc)])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String                @map("conversation_id") @db.ObjectId
  tenantId       String                @map("tenant_id") @db.ObjectId
  role           AssistantMessageRole  @default(USER)
  text           String
  intent         String?
  structuredData String?               @map("structured_data")
  createdAt      DateTime              @default(now()) @map("created_at")

  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("assistant_messages")
}
